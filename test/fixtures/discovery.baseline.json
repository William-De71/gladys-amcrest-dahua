      {
        "key": "intro",
        "type": "section"
      },
      {
        "key": "username",
        "type": "string"
      },
      {
        "key": "password",
        "type": "secret"
      },
      {
        "key": "options",
        "type": "section"
      },
      {
        "key": "image_refresh_interval",
        "type": "number"
      },
      {
        "key": "snapshot_on_detection",
        "type": "boolean"
      },
      {
        "key": "stream",
        "type": "select"
      },
      {
        "key": "advanced",
        "type": "section"
      },
      {
        "key": "camera_addresses",
        "type": "string"
      },
      {
        "key": "camera_accounts",
        "type": "secret"
      }
    ],
    "actions": ["test_connection", "refresh_images"],
    "scene_triggers": [
      {
        "key": "detection",
        "fields": [
          {
            "key": "camera",
            "options": []
          },
          {
            "key": "kind",
            "options": [
              "motion",
              "person",
              "vehicle",
              "tripwire",
              "intrusion",
              "audio",
              "tamper",
              "doorbell"
            ]
          }
        ],
        "variables": [
          {
            "key": "camera_name",
            "type": "string"
          },
          {
            "key": "kind",
            "type": "string"
          },
          {
            "key": "rule",
            "type": "string"
          },
          {
            "key": "object_type",
            "type": "string"
          }
        ]
      },
      {
        "key": "alarm",
        "fields": [
          {
            "key": "camera",
            "options": []
          },
          {
            "key": "kind",
            "options": [
              "video_loss",
              "alarm_input",
              "storage_failure",
              "storage_low_space",
              "no_storage"
            ]
          }
        ],
        "variables": [
          {
            "key": "camera_name",
            "type": "string"
          },
          {
            "key": "kind",
            "type": "string"
          }
        ]
      },
      {
        "key": "connection_lost",
        "fields": [
          {
            "key": "camera",
            "options": []
          }
        ],
        "variables": [
          {
            "key": "camera_name",
            "type": "string"
          },
          {
            "key": "reason",
            "type": "string"
          }
        ]
      },
      {
        "key": "connection_restored",
        "fields": [
          {
            "key": "camera",
            "options": []
          }
        ],
        "variables": [
          {
            "key": "camera_name",
            "type": "string"
          }
        ]
      }
    ],
    "scene_actions": [
      {
        "key": "take_snapshot",
        "fields": ["camera"],
        "options": {},
        "outputs": [
          {
            "key": "captured_at",
            "type": "string"
          },
          {
            "key": "size_kb",
            "type": "number"
          }
        ]
      },
      {
        "key": "set_recording",
        "fields": ["camera", "mode"],
        "options": {
          "mode": ["auto", "manual", "off"]
        },
        "outputs": []
      },
      {
        "key": "open_door",
        "fields": ["camera", "door"],
        "options": {},
        "outputs": []
      },
      {
        "key": "reboot",
        "fields": ["camera"],
        "options": {},
        "outputs": []
      }
    ],
    "widgets": [
      {
        "key": "cameras",
        "settings": []
      },
      {
        "key": "detections",
        "settings": ["camera", "count"]
      },
      {
        "key": "storage",
        "settings": ["camera"]
      }
    ],
    "widget_actions": ["refresh_images"]
  }
